# RAG Health & Fitness Engine - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Elasticsearch Configuration
# ============================================
# Get these from your Elastic Cloud deployment:
# 1. Go to https://cloud.elastic.co/
# 2. Create a 14-day trial deployment
# 3. Copy the Cloud ID or endpoint URL
# 4. Generate an API key from Stack Management > API Keys

ELASTICSEARCH_URL=https://your-deployment-id.es.us-central1.gcp.cloud.es.io:443
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here

# ============================================
# Google Gemini API Configuration
# ============================================
# Get your API key from Google AI Studio:
# 1. Go to https://makersuite.google.com/app/apikey
# 2. Create a new API key
# 3. Copy the key here

GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Optional: Node Environment
# ============================================
# Set to 'development' for local testing
# Set to 'production' for deployment

NODE_ENV=development

# ============================================
# Optional: Ingestion Script Configuration
# ============================================
# These are used by the Python ingestion scripts
# You can use the same Elasticsearch credentials as above

# Maximum number of exercises to ingest (leave empty for all)
MAX_EXERCISES=1000

# Maximum number of recipes to ingest (leave empty for all)
MAX_RECIPES=5000

# Batch size for bulk indexing
BULK_BATCH_SIZE=100
